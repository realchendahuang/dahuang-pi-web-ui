{
  "name": "@realchendahuang/dahuang-pi-web-ui",
  "version": "0.202608.1",
  "description": "Pi Agent — native macOS shell (SwiftUI) hosting a supervised bundled Pi Runtime. The Node/Runtime substrate lives here only as the embedded session daemon that the Swift app supervises; there is no web UI and no npm publishing.",
  "license": "MIT",
  "author": "Kim <realchendahuang@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:plugin-api && npm run build:plugins",
    "build:plugin-api": "tsc -p tsconfig.plugin-api.json",
    "build:plugins": "tsc -p tsconfig.plugins.json && node scripts/build-plugins.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:cached": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/pi-web/typecheck.tsbuildinfo",
    "knip": "knip",
    "lint": "eslint \"src/**/*.ts\" \"extensions/**/*.ts\" \"pi-web-plugins/**/*.ts\" vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run knip && npm test",
    "verify:staged": "node scripts/verify-staged.mjs",
    "start:sessiond": "tsx watch src/server/sessiond.ts",
    "dev:sessiond": "tsx watch src/server/sessiond.ts",
    "dev:plugins": "node scripts/build-plugins.mjs --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "diff": "^9.0.0",
    "fastify": "^5.10.0",
    "lit": "^3.3.3",
    "node-pty": "^1.1.0",
    "typebox": "1.3.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.81.1",
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "knip": "^6.25.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realchendahuang/dahuang-pi-web-ui.git"
  },
  "bugs": {
    "url": "https://github.com/realchendahuang/dahuang-pi-web-ui/issues"
  },
  "packageManager": "npm@11.11.0"
}
